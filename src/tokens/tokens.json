{
  "$description": "uookie.net design tokens — single source of truth (W3C DTCG format). Generates src/styles/tokens.css and export/tokens.json.",
  "color": {
    "$type": "color",
    "navy": { "$value": "#1F3864", "$description": "Headings, emphasis", "$extensions": { "mode": { "dark": "#C9D8EE" } } },
    "accent": { "$value": "#2E75B6", "$description": "Numbers, highlights, large text", "$extensions": { "mode": { "dark": "#6FA8E0" } } },
    "accent-strong": { "$value": "#245E94", "$description": "Small link text (AA on surface-alt)", "$extensions": { "mode": { "dark": "#8BBBEA" } } },
    "accent-soft": { "$value": "#D6E4F3", "$description": "Tinted fills, badges", "$extensions": { "mode": { "dark": "#1C3350" } } },
    "text": { "$value": "#1A1A1A", "$extensions": { "mode": { "dark": "#E8EDF4" } } },
    "muted": { "$value": "#595959", "$extensions": { "mode": { "dark": "#A3AEBD" } } },
    "surface": { "$value": "#FFFFFF", "$extensions": { "mode": { "dark": "#0F1622" } } },
    "surface-alt": { "$value": "#EEF3F9", "$extensions": { "mode": { "dark": "#16202F" } } },
    "line": { "$value": "#BFC9D6", "$extensions": { "mode": { "dark": "#2C3A4E" } } },
    "line-soft": { "$value": "#DDE4EC", "$extensions": { "mode": { "dark": "#222E40" } } },
    "data-iot": { "$value": "#2E75B6", "$description": "Diagram layer: IoT devices", "$extensions": { "mode": { "dark": "#6FA8E0" } } },
    "data-robot": { "$value": "#2F8F83", "$description": "Diagram layer: robots", "$extensions": { "mode": { "dark": "#5CC2B4" } } },
    "data-ship": { "$value": "#6B5BB5", "$description": "Diagram layer: ships", "$extensions": { "mode": { "dark": "#A396E3" } } },
    "data-heat": { "$value": "#D9822B", "$description": "Diagram layer: heatmap / energy", "$extensions": { "mode": { "dark": "#F0A55A" } } }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Pretendard Variable", "Pretendard", "system-ui", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    }
  },
  "size": {
    "$type": "dimension",
    "$description": "Designed on a 1280px page frame. Inside a Section they scale with the frame (x1.5 on the 1920px PDF page).",
    "display": { "$value": "72px" },
    "h1": { "$value": "44px" },
    "h2": { "$value": "32px" },
    "h3": { "$value": "22px" },
    "body": { "$value": "18px" },
    "small": { "$value": "15px" },
    "caption": { "$value": "13px" },
    "stat": { "$value": "56px" }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "24px" },
    "6": { "$value": "32px" },
    "7": { "$value": "48px" },
    "8": { "$value": "64px" },
    "9": { "$value": "96px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "lg": { "$value": "16px" },
    "pill": { "$value": "999px" }
  },
  "stroke": {
    "$type": "dimension",
    "$description": "SVG diagram line weights",
    "hair": { "$value": "1px" },
    "base": { "$value": "1.5px" },
    "bold": { "$value": "2.5px" }
  },
  "layout": {
    "$type": "dimension",
    "page-width": { "$value": "1280px", "$description": "Section design frame (web max width)" },
    "print-width": { "$value": "1920px" },
    "print-height": { "$value": "1080px" },
    "gutter": { "$value": "24px" },
    "page-padding": { "$value": "64px" }
  }
}
