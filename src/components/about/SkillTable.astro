---
/** Category · items · where-used table for tools and skills (profile.tools / profile.skills). */
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

interface Row {
  category: string;
  items: string[];
  basis: string;
}
interface Props {
  rows: Row[];
  caption: string;
  /** Column header for the items ("툴" / "기술"). */
  itemLabel: string;
  /** Hide the where-used column (compact resume view). */
  compact?: boolean;
}
const { rows, caption, itemLabel, compact = false } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---

<table class:list={['skills', compact && 'skills--compact']}>
  <caption class="visually-hidden">{caption}</caption>
  <thead>
    <tr>
      <th scope="col">{t.about.category}</th>
      <th scope="col">{itemLabel}</th>
      {!compact && <th scope="col">{t.about.basis}</th>}
    </tr>
  </thead>
  <tbody>
    {
      rows.map((row) => (
        <tr>
          <th scope="row">{row.category}</th>
          <td>
            <ul class="chips">
              {row.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </td>
          {!compact && <td class="basis">{row.basis}</td>}
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .skills {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
  }

  thead th {
    padding-bottom: calc(8 * var(--px));
    color: var(--color-muted);
    font-size: var(--fs-caption);
    font-weight: var(--font-weight-semibold);
    text-align: left;
  }

  tbody tr {
    border-top: var(--stroke-hair) solid var(--color-line);
  }

  tbody th,
  td {
    padding: calc(8 * var(--px)) calc(16 * var(--px)) calc(8 * var(--px)) 0;
    text-align: left;
    vertical-align: top;
    line-height: 1.45;
  }

  tbody th {
    width: 16%;
    color: var(--color-navy);
    font-weight: var(--font-weight-semibold);
    white-space: nowrap;
  }

  .basis {
    width: 32%;
    color: var(--color-muted);
    font-size: var(--fs-caption);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: calc(4 * var(--px)) calc(6 * var(--px));
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: calc(1 * var(--px)) calc(9 * var(--px));
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    border: var(--stroke-hair) solid var(--color-line-soft);
    font-size: var(--fs-caption);
    line-height: 1.6;
  }

  .skills--compact tbody th {
    width: 30%;
    white-space: normal;
  }

  .skills--compact tbody th,
  .skills--compact td {
    padding-block: calc(5 * var(--px));
  }

  @media screen and (max-width: 767px) {
    thead {
      display: none;
    }
    tbody tr {
      display: grid;
      gap: calc(6 * var(--px));
      padding-block: calc(10 * var(--px));
    }
    tbody th,
    td {
      width: auto !important;
      padding: 0;
    }
  }
</style>
