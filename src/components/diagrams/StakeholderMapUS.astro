---
/**
 * US multifamily stakeholder structure (roles only, no company names) — redrawn from the research
 * structure: Developer is the decision maker; Owner invests; architect / GC / property management
 * propose and advise. Text: src/content/visuals.<lang>.json → b2bStakeholdersUS.
 */
import { getLangFromUrl } from '@/i18n/utils';
import { getVisuals } from '@/lib/content';
const __lang = getLangFromUrl(Astro.url);
const visuals = getVisuals(__lang);

const v = visuals.b2bStakeholdersUS;
const row = [
  { id: 'architect', x: 20, title: v.architect, sub: v.architectSub },
  { id: 'gc', x: 225, title: v.gc, sub: v.gcSub },
  { id: 'pm', x: 430, title: v.pm, sub: v.pmSub },
];
---

<svg class="map" viewBox="0 0 640 400" role="img" aria-label={v.label} xmlns="http://www.w3.org/2000/svg" font-family="Pretendard, system-ui, sans-serif">
  <!-- links -->
  <g class="link">
    <path d="M320 62 V100" />
    <path d="M320 162 V200 H115 V250" />
    <path d="M320 162 V250" />
    <path d="M320 200 H525 V250" />
    <path d="M525 312 V340" />
  </g>
  <text class="link-label" x="330" y="86">{v.invest}</text>
  <text class="link-label" x="200" y="194" text-anchor="middle">{v.design}</text>
  <text class="link-label" x="330" y="232">{v.build}</text>
  <text class="link-label" x="440" y="194" text-anchor="middle">{v.operate}</text>

  <g id="owner">
    <rect class="box" x="245" y="14" width="150" height="48" rx="10" />
    <text class="name" x="320" y="36" text-anchor="middle">{v.owner}</text>
    <text class="sub" x="320" y="53" text-anchor="middle">{v.ownerSub}</text>
  </g>

  <g id="developer">
    <rect class="box box--key" x="225" y="100" width="190" height="62" rx="12" />
    <text class="name name--key" x="320" y="127" text-anchor="middle">{v.developer}</text>
    <text class="sub" x="320" y="146" text-anchor="middle">{v.developerSub}</text>
    <rect class="badge" x="428" y="118" width="112" height="26" rx="13" />
    <text class="badge-text" x="484" y="135" text-anchor="middle">★ {v.decision}</text>
  </g>

  {
    row.map((b) => (
      <g id={b.id}>
        <rect class="box" x={b.x} y="250" width="190" height="62" rx="10" />
        <text class="name" x={b.x + 95} y="276" text-anchor="middle">{b.title}</text>
        <text class="sub" x={b.x + 95} y="295" text-anchor="middle">{b.sub}</text>
      </g>
    ))
  }

  <g id="residents">
    <rect class="box box--soft" x="430" y="340" width="190" height="40" rx="10" />
    <text class="name" x="525" y="365" text-anchor="middle">{v.residents}</text>
  </g>

  <text class="note" x="20" y="366">{v.note}</text>
</svg>

<style>
  .map {
    width: 100%;
    height: auto;
  }

  .link path {
    fill: none;
    stroke: var(--color-line);
    stroke-width: 1.5;
  }

  .link-label {
    fill: var(--color-muted);
    font-size: 11px;
    font-weight: 600;
  }

  .box {
    fill: var(--color-surface);
    stroke: var(--color-line);
    stroke-width: 1.2;
  }

  .box--key {
    fill: var(--color-accent-soft);
    stroke: var(--color-accent);
    stroke-width: 2.5;
  }

  .box--soft {
    fill: var(--color-surface-alt);
  }

  .name {
    fill: var(--color-navy);
    font-size: 14px;
    font-weight: 700;
  }

  .name--key {
    font-size: 17px;
  }

  .sub {
    fill: var(--color-muted);
    font-size: 11px;
  }

  .badge {
    fill: var(--color-accent);
  }

  .badge-text {
    fill: var(--color-surface);
    font-size: 11px;
    font-weight: 700;
  }

  .note {
    fill: var(--color-muted);
    font-size: 12px;
  }
</style>
