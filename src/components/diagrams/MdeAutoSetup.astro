---
/**
 * Small card illustration: automatic setup — open the box → nearby Galaxy device detects it →
 * one-click connect → done. Text: src/content/visuals.<lang>.json → mdeAutoSetup.
 */
import { getLangFromUrl } from '@/i18n/utils';
import { getVisuals } from '@/lib/content';
const __lang = getLangFromUrl(Astro.url);
const visuals = getVisuals(__lang);

const v = visuals.mdeAutoSetup;
const xs = [40, 133, 226, 319];
---

<svg class="mini" viewBox="0 0 360 104" role="img" aria-label={v.label} xmlns="http://www.w3.org/2000/svg" font-family="Pretendard, system-ui, sans-serif">
  {
    xs.map((x, i) => (
      <g>
        <circle class:list={['step', i === 3 && 'step--done']} cx={x} cy="34" r="22" />
        {i === 0 && <path class="icon" d={`M${x - 11} 30 l11 -7 l11 7 v12 h-22 z M${x - 11} 30 h22`} />}
        {i === 1 && <path class="icon" d={`M${x - 4} 40 a6 6 0 0 1 8 0 M${x - 9} 34 a13 13 0 0 1 18 0 M${x - 14} 28 a20 20 0 0 1 28 0`} />}
        {i === 2 && <path class="icon" d={`M${x - 12} 34 h8 M${x + 4} 34 h8 M${x - 4} 29 h8 v10 h-8 z`} />}
        {i === 3 && <path class="icon icon--done" d={`M${x - 9} 34 l6 6 l12 -13`} />}
        <text class="label" x={x} y="80" text-anchor="middle">{v.steps[i]}</text>
        {i < 3 && <path class="arrow" d={`M${x + 28} 34 H${xs[i + 1] - 28} M${xs[i + 1] - 34} 29 L${xs[i + 1] - 28} 34 L${xs[i + 1] - 34} 39`} />}
      </g>
    ))
  }
  <text class="note" x="180" y="100" text-anchor="middle">{v.note}</text>
</svg>

<style>
  .mini {
    width: 100%;
    height: auto;
    max-height: calc(118 * var(--px, 1px));
  }

  .step {
    fill: var(--color-surface);
    stroke: var(--color-line);
    stroke-width: 1.4;
  }

  .step--done {
    fill: var(--color-accent-soft);
    stroke: var(--color-accent);
  }

  .icon {
    fill: none;
    stroke: var(--color-navy);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon--done {
    stroke: var(--color-accent-strong);
    stroke-width: 2.4;
  }

  .arrow {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .label {
    fill: var(--color-navy);
    font-size: 12.5px;
    font-weight: 700;
  }

  .note {
    fill: var(--color-muted);
    font-size: 11.5px;
  }
</style>
