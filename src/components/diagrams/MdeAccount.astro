---
/**
 * Small card illustration: one connection method across divisions — devices stored under the
 * Samsung account / cloud, so phone (Mobile), TV (VD) and appliances (DA) plus industry-standard
 * devices hand the connection over the same way. Text: src/content/visuals.<lang>.json → mdeAccount.
 */
import { getLangFromUrl } from '@/i18n/utils';
import { getVisuals } from '@/lib/content';
const __lang = getLangFromUrl(Astro.url);
const visuals = getVisuals(__lang);

const v = visuals.mdeAccount;
const nodes = [
  { x: 44, label: v.nodes[0] },
  { x: 134, label: v.nodes[1] },
  { x: 224, label: v.nodes[2] },
  { x: 314, label: v.standard, dashed: true },
];
---

<svg class="mini" viewBox="0 0 360 104" role="img" aria-label={v.label} xmlns="http://www.w3.org/2000/svg" font-family="Pretendard, system-ui, sans-serif">
  <rect class="cloud" x="80" y="2" width="200" height="30" rx="15" />
  <text class="cloud-text" x="180" y="22" text-anchor="middle">{v.cloud}</text>
  <g class="links">
    {nodes.map((n) => <path d={`M180 32 C 180 44, ${n.x} 44, ${n.x} 56`} />)}
  </g>
  {
    nodes.map((n) => (
      <g>
        <rect class:list={['node', n.dashed && 'node--dashed']} x={n.x - 42} y="56" width="84" height="28" rx="8" />
        <text class="node-text" x={n.x} y="75" text-anchor="middle">{n.label}</text>
      </g>
    ))
  }
  <text class="note" x="180" y="101" text-anchor="middle">{v.note}</text>
</svg>

<style>
  .mini {
    width: 100%;
    height: auto;
    max-height: calc(118 * var(--px, 1px));
  }

  .cloud {
    fill: var(--color-accent-soft);
    stroke: var(--color-accent);
    stroke-width: 1.4;
  }

  .cloud-text {
    fill: var(--color-navy);
    font-size: 13px;
    font-weight: 700;
  }

  .links path {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.3;
  }

  .node {
    fill: var(--color-surface);
    stroke: var(--color-line);
    stroke-width: 1.3;
  }

  .node--dashed {
    stroke: var(--color-accent);
    stroke-dasharray: 4 3;
  }

  .node-text {
    fill: var(--color-navy);
    font-size: 12px;
    font-weight: 700;
  }

  .note {
    fill: var(--color-muted);
    font-size: 11.5px;
  }
</style>
