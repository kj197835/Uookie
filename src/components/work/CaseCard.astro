---
import { caseNumber, caseSlug, type Case } from '@/lib/cases';
import StatusBadges from './StatusBadges.astro';
import { getLangFromUrl, localizePath, useTranslations } from '@/i18n/utils';

interface Props {
  entry: Case;
  compact?: boolean;
}
const { entry, compact = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { data } = entry;
const href = localizePath(`/work/${caseSlug(entry)}`, lang);
---

<article class:list={['case-card', compact && 'case-card--compact']}>
  <p class="case-card__meta">
    <span class="case-card__no">{caseNumber(entry)}</span>
    <span>{data.theme}</span>
  </p>
  <h3 class="case-card__title">
    <a href={href}>{data.title}</a>
  </h3>
  <p class="case-card__summary">{data.summary}</p>
  <p class="case-card__period">{data.period}</p>
  <StatusBadges status={data.status} />
  {
    data.awards.length > 0 && (
      <ul class="case-card__awards" aria-label={t.work.awards}>
        {data.awards.map((a) => (
          <li>
            {a.name} {a.year}
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .case-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: calc(10 * var(--px));
    padding: calc(24 * var(--px));
    border: var(--stroke-hair) solid var(--color-line-soft);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    transition: border-color 0.2s, transform 0.2s;
  }

  .case-card:hover,
  .case-card:focus-within {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .case-card__meta {
    display: flex;
    gap: calc(12 * var(--px));
    color: var(--color-muted);
    font-size: var(--fs-caption);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .case-card__no {
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .case-card__title {
    font-size: var(--fs-h3);
  }

  .case-card__title a {
    color: inherit;
    text-decoration: none;
  }

  /* Whole card is clickable; the link text stays the accessible name. */
  .case-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .case-card__summary {
    color: var(--color-text);
    font-size: var(--fs-small);
    line-height: 1.6;
  }

  .case-card--compact .case-card__summary {
    color: var(--color-muted);
  }

  .case-card__period {
    margin-top: auto;
    color: var(--color-muted);
    font-size: var(--fs-caption);
    font-variant-numeric: tabular-nums;
  }

  .case-card__awards {
    display: flex;
    flex-wrap: wrap;
    gap: calc(6 * var(--px));
    padding: 0;
    list-style: none;
  }

  .case-card__awards li {
    padding: calc(2 * var(--px)) calc(10 * var(--px));
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-navy);
    font-size: var(--fs-caption);
    font-weight: var(--font-weight-medium);
  }
</style>
