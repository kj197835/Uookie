---
/**
 * Concept (not the real internal system): PRD in Confluence/Jira + AI-ready design tokens
 * → Claude via Figma MCP → auto-generated Figma UI guide.
 * Cards use a fixed light palette; arrows and step labels follow the page theme.
 * Text: src/content/visuals.<lang>.json → genaiPipeline.
 */
import { getLangFromUrl } from '@/i18n/utils';
import { getVisuals } from '@/lib/content';
const __lang = getLangFromUrl(Astro.url);
const visuals = getVisuals(__lang);

const v = visuals.genaiPipeline;
const [confluence, jira] = v.sources;
const swatches = ['#2e75b6', '#a9c6e6', '#1f3864', '#d6e4f3'];
const sparkle = (cx: number, cy: number, s: number) =>
  `M${cx} ${cy - s} Q${cx} ${cy} ${cx + s} ${cy} Q${cx} ${cy} ${cx} ${cy + s} Q${cx} ${cy} ${cx - s} ${cy} Q${cx} ${cy} ${cx} ${cy - s}Z`;
---

<svg class="mock" viewBox="0 0 640 400" role="img" aria-label={v.label} xmlns="http://www.w3.org/2000/svg" font-family="Pretendard, system-ui, sans-serif">
  <!-- PRD sources -->
  <text class="label" x="10" y="26">{v.sourcesTitle}</text>
  <g id="prd-confluence">
    <rect class="screen" x="10" y="40" width="160" height="110" rx="10" />
    <text class="s-strong" x="24" y="62" font-size="12">{confluence.tool}</text>
    <rect class="s-line-fill" x="24" y="76" width="120" height="6" rx="3" />
    <rect class="s-line-fill" x="24" y="90" width="132" height="6" rx="3" />
    <rect class="s-line-fill" x="24" y="104" width="96" height="6" rx="3" />
    <text class="s-muted" x="24" y="136" font-size="10.5">{confluence.text}</text>
  </g>
  <g id="prd-jira">
    <rect class="screen" x="10" y="170" width="160" height="110" rx="10" />
    <text class="s-strong" x="24" y="192" font-size="12">{jira.tool}</text>
    {
      [0, 1, 2].map((i) => (
        <g>
          <rect class="s-ticket" x="24" y={204 + i * 16} width="10" height="10" rx="2" />
          <rect class="s-line-fill" x="40" y={206 + i * 16} width={[100, 86, 110][i]} height="6" rx="3" />
        </g>
      ))
    }
    <text class="s-muted" x="24" y="266" font-size="10.5">{jira.text}</text>
  </g>

  <!-- AI-ready tokens -->
  <g id="tokens">
    <rect class="screen" x="222" y="14" width="196" height="136" rx="10" />
    <text class="s-strong" x="236" y="36" font-size="12">{v.tokensTitle}</text>
    {
      v.tokens.map((token, i) => (
        <g>
          <rect x="236" y={48 + i * 20} width="10" height="10" rx="2" fill={swatches[i]} />
          <text class="s-code" x="252" y={57 + i * 20} font-size="9.5">{token}</text>
        </g>
      ))
    }
    <text class="s-muted" x="236" y="140" font-size="9.5">{v.tokensNote}</text>
  </g>

  <!-- Claude + Figma MCP -->
  <g id="agent">
    <circle class="agent-halo" cx="320" cy="250" r="56" />
    <circle class="agent" cx="320" cy="250" r="44" />
    <path class="agent-spark" d={sparkle(320, 250, 18)} />
    <text class="agent-name" x="320" y="326" text-anchor="middle">{v.agent}</text>
    <text class="agent-sub" x="320" y="344" text-anchor="middle">{v.agentSub}</text>
  </g>

  <!-- Figma UI guide -->
  <g id="figma-guide">
    <text class="label" x="450" y="60">{v.outputNote}</text>
    <rect class="screen" x="450" y="70" width="180" height="262" rx="10" />
    <text class="s-strong" x="464" y="94" font-size="12">{v.outputTitle}</text>
    <path class="s-divider" d="M450 106 H630" />
    <rect class="s-button" x="464" y="120" width="84" height="26" rx="13" />
    <rect class="s-button-label" x="480" y="130" width="52" height="6" rx="3" />
    <path class="spec" d="M556 146 V168 M552 146 H560 M552 168 H560" />
    <text class="spec-text" x="564" y="161" font-size="9">space.200</text>
    <rect class="s-input" x="464" y="168" width="152" height="28" rx="6" />
    <rect class="s-line-fill" x="474" y="179" width="70" height="6" rx="3" />
    <rect class="s-tile" x="464" y="208" width="152" height="74" rx="8" />
    <rect class="s-line-strong" x="476" y="220" width="80" height="7" rx="3.5" />
    <rect class="s-line-fill" x="476" y="236" width="124" height="5" rx="2.5" />
    <rect class="s-line-fill" x="476" y="248" width="104" height="5" rx="2.5" />
    <path class="spec" d="M464 292 H616 M464 288 V296 M616 288 V296" />
    <text class="spec-text" x="540" y="310" font-size="9" text-anchor="middle">border.radius.100</text>
  </g>

  <!-- flows -->
  <g class="flow">
    <path d="M174 95 C 230 110, 250 190, 272 232" />
    <path d="M174 225 C 220 230, 240 245, 266 250" />
    <path d="M320 154 V188" />
    <path d="M372 250 C 400 250, 420 220, 446 206" />
  </g>
  <path class="arrow" d="M266 226 L273 234 L263 237" />
  <path class="arrow" d="M259 245 L267 250 L259 255" />
  <path class="arrow" d="M315 182 L320 190 L325 182" />
  <path class="arrow" d="M438 202 L447 205 L441 213" />
  <text class="step" x="178" y="168">{v.steps[0]}</text>
  <text class="step" x="328" y="178">{v.steps[1]}</text>
  <text class="step" x="382" y="276">{v.steps[2]}</text>
</svg>

<style>
  .mock {
    width: 100%;
    height: auto;
    --s-bg: #ffffff;
    --s-alt: #eef3f9;
    --s-line: #d5dde7;
    --s-navy: #1f3864;
    --s-accent: #2e75b6;
    --s-soft: #d6e4f3;
    --s-muted: #6b7788;
  }

  .label {
    fill: var(--color-muted);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .screen { fill: var(--s-bg); stroke: var(--s-line); }
  .s-strong { fill: var(--s-navy); font-weight: 700; }
  .s-muted { fill: var(--s-muted); }
  .s-code { fill: var(--s-navy); font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  .s-line-fill { fill: var(--s-line); }
  .s-line-strong { fill: var(--s-navy); }
  .s-ticket { fill: var(--s-soft); stroke: var(--s-accent); }
  .s-divider { fill: none; stroke: var(--s-line); }
  .s-button { fill: var(--s-accent); }
  .s-button-label { fill: #ffffff; opacity: 0.85; }
  .s-input { fill: var(--s-bg); stroke: var(--s-line); }
  .s-tile { fill: var(--s-alt); }

  .spec { fill: none; stroke: #d9822b; stroke-width: 1; }
  .spec-text { fill: #b86a1c; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }

  .agent { fill: var(--s-navy); }
  .agent-halo { fill: none; stroke: var(--color-accent); stroke-width: 1; stroke-dasharray: 3 4; }
  .agent-spark { fill: #ffffff; }
  .agent-name { fill: var(--color-navy); font-size: 14px; font-weight: 700; }
  .agent-sub { fill: var(--color-muted); font-size: 11px; font-weight: 600; }

  .flow path {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.4;
    stroke-dasharray: 3 4;
  }

  .arrow {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .step {
    fill: var(--color-accent-strong);
    font-size: 11px;
    font-weight: 700;
  }
</style>
