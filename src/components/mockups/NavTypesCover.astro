---
/**
 * Cover visual for the Advanced UX case: five screens whose bottom navigation bar takes a
 * different type (hidden / transparent / opaque / translucent) to suit the screen.
 * Phone images are cropped from the user's 2016 invention material (slide text left out);
 * labels are typeset here. Text: src/content/visuals.<lang>.json → navCover.
 */
import { getLangFromUrl } from '@/i18n/utils';
import { getVisuals } from '@/lib/content';
const __lang = getLangFromUrl(Astro.url);
const visuals = getVisuals(__lang);

const v = visuals.navCover;
---

<div class="nav" role="img" aria-label={v.label}>
  <p class="nav__title">{v.title}</p>
  <p class="nav__lead">{v.lead}</p>
  <ul class="nav__row">
    {
      v.screens.map((s) => (
        <li>
          <img src={s.src} alt="" loading="eager" decoding="async" />
          <span class="nav__name">{s.name}</span>
          <span class="nav__type">{s.type}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .nav {
    display: flex;
    flex-direction: column;
    gap: calc(6 * var(--px, 1px));
  }

  .nav__title {
    color: var(--color-navy);
    font-size: var(--fs-small, var(--size-small));
    font-weight: var(--font-weight-bold);
  }

  .nav__lead {
    color: var(--color-muted);
    font-size: var(--fs-caption, var(--size-caption));
  }

  .nav__row {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: calc(8 * var(--px, 1px));
    margin: calc(10 * var(--px, 1px)) 0 0;
    padding: 0;
    list-style: none;
  }

  .nav__row li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(4 * var(--px, 1px));
    text-align: center;
  }

  .nav__row img {
    width: 100%;
    height: auto;
    margin-bottom: calc(6 * var(--px, 1px));
  }

  .nav__name {
    color: var(--color-navy);
    font-size: var(--fs-caption, var(--size-caption));
    font-weight: var(--font-weight-semibold);
    line-height: 1.3;
    white-space: nowrap;
  }

  .nav__type {
    padding: 0 calc(8 * var(--px, 1px));
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-accent) 22%, transparent);
    color: var(--color-navy);
    font-size: var(--fs-caption, var(--size-caption));
    font-weight: var(--font-weight-semibold);
    line-height: 1.7;
    white-space: nowrap;
  }
</style>
