---
/**
 * Concept (not a real screen): SmartThings Pro feature menus converging into one AI chat that can
 * run them. Screens use a fixed light palette; flow arrows follow the page theme.
 * Text: src/content/visuals.<lang>.json → genaiChatbot.
 */
import { getLangFromUrl } from '@/i18n/utils';
import { getVisuals } from '@/lib/content';
const __lang = getLangFromUrl(Astro.url);
const visuals = getVisuals(__lang);

const v = visuals.genaiChatbot;
const m = v.messages;
const CARD_H = 40;
const cardY = (i: number) => 38 + i * 56;
const chartBars = [26, 34, 20, 38, 30, 42, 24, 32];
const sparkle = (cx: number, cy: number, s: number) =>
  `M${cx} ${cy - s} Q${cx} ${cy} ${cx + s} ${cy} Q${cx} ${cy} ${cx} ${cy + s} Q${cx} ${cy} ${cx - s} ${cy} Q${cx} ${cy} ${cx} ${cy - s}Z`;
---

<svg class="mock" viewBox="0 8 640 422" role="img" aria-label={v.label} xmlns="http://www.w3.org/2000/svg" font-family="Pretendard, system-ui, sans-serif">
  <text class="label" x="10" y="24">{v.menuLabel}</text>

  <g id="feature-menus">
    {
      v.features.map((f, i) => (
        <g>
          <rect class="screen" x="10" y={cardY(i)} width="190" height={CARD_H} rx="10" />
          <rect class="s-icon" x="22" y={cardY(i) + 10} width="20" height="20" rx="5" />
          <text class="s-strong" x="52" y={cardY(i) + 25} font-size="12">{f}</text>
        </g>
      ))
    }
  </g>

  <g id="converge" class="flow">
    {v.features.map((_, i) => <path d={`M204 ${cardY(i) + CARD_H / 2} C 236 ${cardY(i) + CARD_H / 2}, 244 214, 266 214`} />)}
  </g>
  <path class="arrow" d="M259 208 L267 214 L259 220" />

  <g id="chat">
    <rect class="screen" x="272" y="30" width="358" height="396" rx="14" />
    <circle class="s-orb" cx="294" cy="50" r="10" />
    <path class="s-spark" d={sparkle(294, 50, 6)} />
    <text class="s-strong" x="312" y="55" font-size="12.5">{v.chatTitle}</text>
    <path class="s-divider" d="M272 70 H630" />

    <rect class="s-user" x="384" y="82" width="232" height="32" rx="16" />
    <text class="s-user-text" x="600" y="102" font-size="11.5" text-anchor="end">{m.user1}</text>

    <path class="s-spark" d={sparkle(292, 140, 6)} />
    <rect class="s-ai" x="306" y="124" width="250" height="32" rx="16" />
    <text class="s-text" x="320" y="144" font-size="11.5">{m.ai1}</text>
    <rect class="s-card" x="306" y="164" width="250" height="46" rx="10" />
    <text class="s-muted" x="320" y="182" font-size="10">{m.cardTitle}</text>
    <text class="s-strong" x="320" y="200" font-size="12">{m.cardValue}</text>
    <rect class="s-chip" x="496" y="177" width="48" height="20" rx="10" />
    <text class="s-chip-text" x="520" y="191" font-size="10" text-anchor="middle">{m.cardStatus}</text>

    <rect class="s-user" x="432" y="226" width="184" height="32" rx="16" />
    <text class="s-user-text" x="600" y="246" font-size="11.5" text-anchor="end">{m.user2}</text>

    <path class="s-spark" d={sparkle(292, 284, 6)} />
    <rect class="s-ai" x="306" y="268" width="180" height="32" rx="16" />
    <text class="s-text" x="320" y="288" font-size="11.5">{m.ai2}</text>
    <rect class="s-card" x="306" y="308" width="250" height="62" rx="10" />
    {chartBars.map((h, i) => <rect class={i === 5 ? 's-bar-strong' : 's-bar-mid'} x={322 + i * 28} y={360 - h} width="14" height={h} rx="3" />)}

    <rect class="s-input" x="286" y="386" width="330" height="28" rx="14" />
    <text class="s-muted" x="302" y="404" font-size="11">{v.placeholder}</text>
    <circle class="s-send" cx="602" cy="400" r="10" />
    <path class="s-send-arrow" d="M598 400 H606 M603 396 L607 400 L603 404" />
  </g>
</svg>

<style>
  .mock {
    width: 100%;
    height: auto;
    --s-bg: #ffffff;
    --s-alt: #eef3f9;
    --s-line: #d5dde7;
    --s-navy: #1f3864;
    --s-accent: #2e75b6;
    --s-soft: #d6e4f3;
    --s-muted: #6b7788;
    --s-text: #1a1a1a;
  }

  .label {
    fill: var(--color-muted);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .screen { fill: var(--s-bg); stroke: var(--s-line); }
  .s-icon { fill: var(--s-soft); }
  .s-strong { fill: var(--s-navy); font-weight: 700; }
  .s-muted { fill: var(--s-muted); }
  .s-text { fill: var(--s-text); }
  .s-divider { fill: none; stroke: var(--s-line); }
  .s-orb { fill: var(--s-soft); }
  .s-spark { fill: var(--s-accent); }
  .s-user { fill: var(--s-accent); }
  .s-user-text { fill: #ffffff; }
  .s-ai { fill: var(--s-alt); }
  .s-card { fill: var(--s-bg); stroke: var(--s-accent); stroke-width: 1.2; }
  .s-chip { fill: var(--s-soft); }
  .s-chip-text { fill: var(--s-navy); font-weight: 700; }
  .s-bar-mid { fill: #a9c6e6; }
  .s-bar-strong { fill: var(--s-accent); }
  .s-input { fill: var(--s-bg); stroke: var(--s-line); }
  .s-send { fill: var(--s-accent); }
  .s-send-arrow { fill: none; stroke: #ffffff; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }

  .flow path {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.2;
    stroke-dasharray: 3 4;
  }

  .arrow {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
