---
/** Recognition: awards → patents & GUI designs → exhibitions. Data: src/content/recognition.json */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import recognition from '@/content/recognition.json';
import { caseSlug, getCases } from '@/lib/cases';
import { getLangFromUrl, localizePath, pick, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const titles = new Map((await getCases(lang)).map((c) => [caseSlug(c), c.data.title]));
const caseLink = (slug: string) => localizePath(`/work/${slug}`, lang);
---

<BaseLayout title={t.recognition.title} description={`${t.recognition.awardsLead} · ${t.recognition.patentsLead}`}>
  <Section id="awards" kind="list" label={t.recognition.awards}>
    <div class="stack page-body">
      <div class="stack gap-s">
        <p class="eyebrow">{t.recognition.title} · {t.recognition.awards}</p>
        <h1 class="t-h1">{t.recognition.awardsLead}</h1>
        <p class="t-small t-muted">{t.recognition.awardsNote}</p>
      </div>
      <ul class="grid awards push-end">
        {
          recognition.awards.map((a) => (
            <li class="col-4">
              <span class="awards__year">{a.year}</span>
              <h2 class="t-h3">{a.award}</h2>
              <p class="t-small">{a.work}</p>
              <p class="awards__links">
                <a href={caseLink(a.case)}>{titles.get(a.case)}</a>
                {a.url && (
                  <a href={a.url} target="_blank" rel="noopener">
                    {t.recognition.official} ↗
                  </a>
                )}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section id="patents" kind="list" label={t.recognition.patents} tone="alt">
    <div class="stack page-body">
      <div class="stack gap-s">
        <p class="eyebrow">{t.recognition.patents}</p>
        <h2 class="t-h2">{t.recognition.patentsLead}</h2>
        <p class="t-small t-muted">{t.recognition.patentsNote}</p>
      </div>
      <table class="patents">
        <caption class="visually-hidden">{t.recognition.patents}</caption>
        <thead>
          <tr>
            <th scope="col">{t.recognition.field}</th>
            <th scope="col">{t.recognition.name}</th>
            <th scope="col">{t.recognition.number}</th>
            <th scope="col">{t.recognition.status}</th>
          </tr>
        </thead>
        <tbody>
          {
            recognition.patents.map((p) => (
              <tr>
                <td class="patents__field">{p.field}</td>
                <th scope="row">{pick(p.title, lang)}</th>
                <td class="patents__no">
                  {p.numbers.map((n) =>
                    'url' in n && n.url ? (
                      <a href={n.url} target="_blank" rel="noopener">
                        {n.no}
                      </a>
                    ) : (
                      <span>{n.no}</span>
                    ),
                  )}
                </td>
                <td>
                  <span class:list={['status', `status--${p.status}`]}>
                    {p.status === 'granted' ? t.recognition.granted : t.recognition.pending}
                  </span>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </Section>

  <Section id="exhibitions" kind="list" label={t.recognition.exhibitions}>
    <div class="stack page-body">
      <div class="stack gap-s">
        <p class="eyebrow">{t.recognition.exhibitions}</p>
        <h2 class="t-h2">{t.recognition.exhibitionsLead}</h2>
      </div>
      <ul class="grid exhibitions push-end">
        {
          recognition.exhibitions.map((e) => (
            <li class="col-6">
              <span class="awards__year">{e.year}</span>
              <h3 class="t-h3">{e.name}</h3>
              <p class="t-small t-muted">{pick(e.role, lang)}</p>
              <p class="awards__links">
                <a href={caseLink(e.case)}>{titles.get(e.case)}</a>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>
</BaseLayout>

<style>
  .page-body {
    flex: 1;
  }

  .gap-s {
    gap: calc(8 * var(--px));
  }

  .awards,
  .exhibitions {
    padding: 0;
    list-style: none;
  }

  .awards li,
  .exhibitions li {
    display: flex;
    flex-direction: column;
    gap: calc(6 * var(--px));
    padding-top: calc(18 * var(--px));
    border-top: var(--stroke-bold) solid var(--color-navy);
  }

  .awards__year {
    color: var(--color-accent);
    font-size: var(--fs-small);
    font-weight: var(--font-weight-bold);
    font-variant-numeric: tabular-nums;
  }

  .awards__links {
    display: flex;
    flex-wrap: wrap;
    gap: calc(4 * var(--px)) calc(16 * var(--px));
    margin-top: auto;
    padding-top: calc(4 * var(--px));
    font-size: var(--fs-small);
    font-weight: var(--font-weight-medium);
  }

  /* Patents table */
  .patents {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
  }

  .patents thead th {
    padding-bottom: calc(8 * var(--px));
    color: var(--color-muted);
    font-size: var(--fs-caption);
    font-weight: var(--font-weight-semibold);
    text-align: left;
  }

  .patents tbody tr {
    border-top: var(--stroke-hair) solid var(--color-line);
  }

  .patents td,
  .patents tbody th {
    padding: calc(4 * var(--px)) calc(12 * var(--px)) calc(4 * var(--px)) 0;
    text-align: left;
    vertical-align: top;
    line-height: 1.35;
  }

  .patents tbody th {
    color: var(--color-navy);
    font-weight: var(--font-weight-semibold);
  }

  .patents__field {
    width: 14%;
    color: var(--color-muted);
  }

  .patents__no {
    display: flex;
    flex-wrap: wrap;
    gap: 0 calc(10 * var(--px));
    font-variant-numeric: tabular-nums;
  }

  .status {
    display: inline-block;
    padding: calc(1 * var(--px)) calc(10 * var(--px));
    border-radius: var(--radius-pill);
    font-size: var(--fs-caption);
    font-weight: var(--font-weight-semibold);
    white-space: nowrap;
  }

  .status--granted {
    background: var(--color-accent-soft);
    color: var(--color-navy);
  }

  .status--pending {
    border: var(--stroke-hair) solid var(--color-line);
    color: var(--color-muted);
  }

  @media (max-width: 767px) {
    .patents thead {
      display: none;
    }
    .patents tbody tr {
      display: grid;
      grid-template-columns: 1fr auto;
      padding-block: calc(10 * var(--px));
    }
    .patents td,
    .patents tbody th {
      width: auto;
      padding: calc(2 * var(--px)) 0;
    }
    .patents tbody th,
    .patents__no {
      grid-column: 1 / -1;
    }
  }
</style>
