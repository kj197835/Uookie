---
/** Home: hero + numbers → selected work → capabilities → career flow → recognition & contact. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import CaseCard from '@/components/work/CaseCard.astro';
import CopyText from '@/components/CopyText.astro';
import CareerFlow from '@/components/about/CareerFlow.astro';
import recognition from '@/content/recognition.json';
import site from '@/content/site.json';
import { caseSlug, getCases } from '@/lib/cases';
import { getLangFromUrl, localizePath, useTranslations } from '@/i18n/utils';
import { getProfile } from '@/lib/content';
const __lang = getLangFromUrl(Astro.url);
const profile = getProfile(__lang);

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const cases = await getCases(lang);
const bySlug = new Map(cases.map((c) => [caseSlug(c), c]));
const featured = cases.filter((c) => c.data.group === 'featured');
const [lead, rest] = [featured.slice(0, 3), featured.slice(3)];
---

<BaseLayout>
  <Section id="hero" kind="hero" label={profile.tagline} pdf="summary">
    <div class="grid hero">
      <div class="col-7 stack hero__text">
        <p class="eyebrow">{profile.role}</p>
        <div class="stack hero__head">
          <h1 class="t-display">
            {profile.name}
            <span class="hero__alt">{profile.nameAlt}</span>
          </h1>
          <p class="t-h2 hero__tagline">{profile.tagline}</p>
        </div>
        <p class="t-small hero__summary">{profile.summary}</p>
      </div>
      <div class="col-5 hero__visual">
        <img
          class="hero__image"
          src="/images/home/spatial-iot-hero.webp"
          alt={t.home.signatureLabel}
          width="1400"
          height="1035"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    </div>
    <ul class="grid numbers" style={`--n:${profile.numbers.length}`} aria-label={t.home.numbers}>
      {
        profile.numbers.map((n) => (
          <li>
            <span class="numbers__value">{n.value}</span>
            <span class="numbers__label">{n.label}</span>
            <span class="numbers__note">{n.note}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="work" kind="list" label={t.home.selected} tone="alt" pdf="none">
    <div class="stack page-body">
      <div class="row-head">
        <div class="stack gap-s">
          <p class="eyebrow">{t.home.selected}</p>
          <h2 class="t-h1">{t.work.title}</h2>
        </div>
        <a class="more" href={localizePath('/work', lang)}>{t.work.viewAll} →</a>
      </div>
      <div class="grid">
        {lead.map((entry) => <div class="col-4 cell"><CaseCard entry={entry} /></div>)}
        {rest.map((entry) => <div class="col-4 cell"><CaseCard entry={entry} compact /></div>)}
      </div>
    </div>
  </Section>

  <Section id="capabilities" kind="content" label={t.home.capabilities}>
    <div class="stack page-body">
      <div class="stack gap-s">
        <p class="eyebrow">{t.home.capabilities}</p>
        <h2 class="t-h1">{t.home.capabilitiesLead}</h2>
      </div>
      <ol class="grid capabilities push-end">
        {
          profile.competencies.map((c, i) => (
            <li class="col-6">
              <span class="cap__no">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="t-h3">{c.title}</h3>
              <p class="t-small t-muted">{c.body}</p>
              <p class="cap__links">
                <span class="visually-hidden">{t.home.related}: </span>
                {c.cases.map((slug) => {
                  const entry = bySlug.get(slug);
                  return entry && <a href={localizePath(`/work/${slug}`, lang)}>{entry.data.title}</a>;
                })}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <Section id="career" kind="content" label={t.home.career} tone="alt">
    <div class="stack page-body">
      <div class="stack gap-s">
        <p class="eyebrow">{t.home.career}</p>
        <h2 class="t-h1">{t.home.careerLead}</h2>
      </div>
      <div class="push-end">
        <CareerFlow />
      </div>
    </div>
  </Section>

  <Section id="recognition" kind="contact" label={t.home.recognition} tone="navy" pdf="summary">
    <div class="stack page-body">
      <div class="row-head">
        <div class="stack gap-s">
          <p class="eyebrow">{t.home.recognition}</p>
          <h2 class="t-h1">{t.home.recognitionLead}</h2>
        </div>
        <a class="more" href={localizePath('/recognition', lang)}>{t.home.viewRecognition} →</a>
      </div>
      <ul class="grid awards">
        {
          recognition.awards.map((a) => (
            <li class="col-4">
              <span class="awards__year">{a.year}</span>
              <span class="awards__name">{a.award}</span>
              <span class="awards__work">{a.work}</span>
            </li>
          ))
        }
      </ul>
      <p class="t-h3 patents-line">{t.home.patentsLine}</p>
      <div class="contact push-end" id="contact">
        <p class="t-h2">{t.home.contactTitle}</p>
        <p class="contact__links">
          <CopyText text={site.contact.email} />
          <a href={site.contact.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
        </p>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .page-body {
    flex: 1;
  }

  .gap-s {
    gap: calc(8 * var(--px));
  }

  /* Hero */
  .hero {
    flex: 1;
    align-items: center;
  }

  .hero__head {
    gap: calc(12 * var(--px));
  }

  .hero__alt {
    display: block;
    margin-top: calc(8 * var(--px));
    color: var(--color-muted);
    font-size: var(--fs-h3);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0;
  }

  .hero__tagline {
    color: var(--color-accent-strong);
    font-weight: var(--font-weight-semibold);
  }

  .hero__summary {
    max-width: 38em;
    color: var(--color-muted);
  }

  .hero__visual {
    align-self: center;
  }

  /* Illustration has a white background: blend it into the light page, show it as a card in dark mode. */
  .hero__image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    mix-blend-mode: multiply;
  }

  :global([data-theme='dark']) .hero__image {
    mix-blend-mode: normal;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .hero__image {
      mix-blend-mode: normal;
    }
  }

  /* Numbers strip */
  .numbers {
    margin-top: calc(24 * var(--px));
    padding: calc(18 * var(--px)) 0 0;
    border-top: var(--stroke-hair) solid var(--color-line);
    list-style: none;
  }

  .numbers li {
    display: flex;
    flex-direction: column;
    gap: calc(4 * var(--px));
  }

  @media (min-width: 1024px), print {
    .numbers {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    }
    .numbers li {
      grid-column: auto;
    }
  }

  @media screen and (min-width: 480px) and (max-width: 1023px) {
    .numbers li {
      grid-column: span 6;
    }
  }

  .numbers__value {
    color: var(--color-accent);
    font-size: calc(var(--fs-stat) * 0.62);
    font-weight: var(--font-weight-bold);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .numbers__label {
    color: var(--color-text);
    font-size: var(--fs-small);
    font-weight: var(--font-weight-medium);
    line-height: 1.4;
  }

  .numbers__note {
    color: var(--color-muted);
    font-size: var(--fs-caption);
  }

  /* Shared heads */
  .row-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: calc(16 * var(--px));
  }

  .more {
    font-size: var(--fs-small);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .cell {
    display: flex;
  }

  .cell > :global(*) {
    flex: 1;
  }

  /* Capabilities */
  .capabilities {
    padding: 0;
    list-style: none;
    row-gap: calc(40 * var(--px));
  }

  .capabilities li {
    display: flex;
    flex-direction: column;
    gap: calc(10 * var(--px));
    padding-top: calc(20 * var(--px));
    border-top: var(--stroke-bold) solid var(--color-navy);
  }

  .cap__no {
    color: var(--color-accent);
    font-size: var(--fs-small);
    font-weight: var(--font-weight-bold);
  }

  .cap__links {
    display: flex;
    flex-wrap: wrap;
    gap: calc(6 * var(--px)) calc(16 * var(--px));
    font-size: var(--fs-small);
    font-weight: var(--font-weight-medium);
  }

  /* Recognition + contact (navy) */
  .awards {
    padding: 0;
    list-style: none;
  }

  .awards li {
    display: flex;
    flex-direction: column;
    gap: calc(2 * var(--px));
    padding: calc(16 * var(--px)) 0;
    border-top: var(--stroke-hair) solid var(--color-line);
  }

  .awards__year {
    color: var(--color-accent);
    font-size: var(--fs-small);
    font-weight: var(--font-weight-bold);
    font-variant-numeric: tabular-nums;
  }

  .awards__name {
    color: var(--color-navy);
    font-size: var(--fs-body);
    font-weight: var(--font-weight-semibold);
  }

  .awards__work {
    color: var(--color-muted);
    font-size: var(--fs-small);
  }

  .patents-line {
    color: var(--color-navy);
    font-weight: var(--font-weight-medium);
  }

  :global(.section--navy) a {
    color: var(--color-accent);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: calc(16 * var(--px));
    padding-top: calc(28 * var(--px));
    border-top: var(--stroke-hair) solid var(--color-line);
  }

  .contact .t-h2 {
    color: var(--color-navy);
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(24 * var(--px));
    font-size: var(--fs-h3);
    font-weight: var(--font-weight-semibold);
  }
</style>
