---
/**
 * Resume: summary, contact, PDF downloads, experience, education, skills & tools.
 * PDF cards appear automatically once the files exist in public/pdf/ (generated in Phase 7).
 */
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import SkillTable from '@/components/about/SkillTable.astro';
import CopyText from '@/components/CopyText.astro';
import profile from '@/content/profile.ko.json';
import career from '@/content/career.ko.json';
import site from '@/content/site.json';
import { getLangFromUrl, localizePath, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pdfs = [
  { file: 'KyungJun_Lee_Portfolio_Full_KO.pdf', label: 'Portfolio · 전체본 (KO)' },
  { file: 'KyungJun_Lee_Portfolio_Summary_KO.pdf', label: 'Portfolio · 요약본 (KO)' },
  { file: 'KyungJun_Lee_Portfolio_Full_EN.pdf', label: 'Portfolio · Full (EN)' },
  { file: 'KyungJun_Lee_Portfolio_Summary_EN.pdf', label: 'Portfolio · Summary (EN)' },
]
  .map((p) => {
    const abs = path.join(process.cwd(), 'public', 'pdf', p.file);
    return fs.existsSync(abs) ? { ...p, mb: (fs.statSync(abs).size / 1024 / 1024).toFixed(1) } : null;
  })
  .filter((p) => p !== null);
---

<BaseLayout title={t.resume.title} description={profile.summary}>
  <Section id="resume" kind="content" label={t.resume.title}>
    <div class="grid page-body">
      <div class="col-7 stack">
        <div class="stack gap-s">
          <p class="eyebrow">{t.resume.title}</p>
          <h1 class="t-h1">{profile.name} <span class="t-muted alt">{profile.nameAlt}</span></h1>
          <p class="t-h3 role">{profile.role}</p>
        </div>
        <p class="t-body t-muted">{profile.summary}</p>
        <ul class="numbers">
          {
            profile.numbers.map((n) => (
              <li>
                <span class="numbers__value">{n.value}</span>
                <span class="t-caption">{n.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <aside class="col-5 stack side">
        <div>
          <h2 class="eyebrow">{t.resume.download}</h2>
          {
            pdfs.length > 0 ? (
              <ul class="pdfs">
                {pdfs.map((p) => (
                  <li>
                    <a href={`/pdf/${p.file}`} download>
                      {p.label}
                    </a>
                    <span class="t-caption">PDF · {p.mb} MB</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="t-small t-muted request">
                {t.resume.requestPdf}
                <CopyText text={site.contact.email} class="request__email" />
              </p>
            )
          }
        </div>
      </aside>
    </div>
  </Section>

  <Section id="experience" kind="content" label={t.resume.career} tone="alt">
    <div class="grid page-body">
      <div class="col-8 stack">
        <h2 class="eyebrow">{t.resume.career} · {career.company}</h2>
        <ol class="experience">
          {
            career.items.map((item) => (
              <li>
                <span class="experience__period">{item.period}</span>
                <div>
                  <p class="experience__title">
                    {item.title} <span class="experience__team">· {item.team}</span>
                  </p>
                  <a class="t-small" href={localizePath(`/work/${item.case}`, lang)}>
                    {item.highlight}
                  </a>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="col-4 stack">
        <div>
          <h2 class="eyebrow">{t.resume.education}</h2>
          <ul class="plain">
            {profile.education.map((e) => <li>{e.title} <span class="t-muted">({e.period})</span></li>)}
            {profile.certifications.map((c) => <li>{c.title} <span class="t-muted">({c.period})</span></li>)}
          </ul>
        </div>
      </div>
    </div>
  </Section>

  <Section id="skills" kind="content" label={t.resume.skills}>
    <div class="grid page-body">
      <div class="col-7 stack">
        <h2 class="eyebrow">{t.resume.skills}</h2>
        <SkillTable rows={profile.skills} caption={t.resume.skills} itemLabel={t.about.skillCol} compact />
      </div>
      <div class="col-5 stack">
        <h2 class="eyebrow">{t.resume.tools}</h2>
        <SkillTable rows={profile.tools} caption={t.resume.tools} itemLabel={t.about.toolCol} compact />
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .page-body {
    flex: 1;
    align-content: start;
  }

  .gap-s {
    gap: calc(8 * var(--px));
  }

  .alt {
    font-size: var(--fs-h3);
    font-weight: var(--font-weight-medium);
  }

  .role {
    color: var(--color-accent-strong);
    font-weight: var(--font-weight-semibold);
  }

  .numbers,
  .pdfs,
  .experience,
  .plain {
    padding: 0;
    list-style: none;
  }

  .numbers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: calc(20 * var(--px));
    padding-top: calc(20 * var(--px));
    border-top: var(--stroke-hair) solid var(--color-line);
  }

  .numbers li {
    display: flex;
    flex-direction: column;
    gap: calc(2 * var(--px));
  }

  .numbers__value {
    color: var(--color-accent);
    font-size: calc(var(--fs-stat) * 0.5);
    font-weight: var(--font-weight-bold);
    line-height: 1.15;
    white-space: nowrap;
  }

  .side {
    padding: calc(28 * var(--px));
    border-radius: var(--radius-lg);
    background: var(--color-surface-alt);
    align-self: start;
  }

  .pdfs {
    display: grid;
    gap: calc(8 * var(--px));
    margin-top: calc(10 * var(--px));
    font-weight: var(--font-weight-medium);
  }

  .pdfs li {
    display: flex;
    justify-content: space-between;
    gap: calc(12 * var(--px));
  }

  .request {
    margin-top: calc(10 * var(--px));
  }

  .request :global(.request__email) {
    display: flex;
    margin-top: calc(8 * var(--px));
    color: var(--color-text);
    font-weight: var(--font-weight-medium);
  }

  .experience {
    display: grid;
    gap: 0;
  }

  .experience li {
    display: grid;
    grid-template-columns: calc(170 * var(--px)) 1fr;
    gap: calc(16 * var(--px));
    padding: calc(6 * var(--px)) 0;
    border-top: var(--stroke-hair) solid var(--color-line);
    line-height: 1.4;
  }

  .experience__period {
    color: var(--color-muted);
    font-size: var(--fs-small);
    font-variant-numeric: tabular-nums;
  }

  .experience__title {
    color: var(--color-navy);
    font-size: var(--fs-small);
    font-weight: var(--font-weight-semibold);
  }

  .experience__team {
    color: var(--color-muted);
    font-size: var(--fs-caption);
    font-weight: var(--font-weight-regular);
  }

  @media (max-width: 767px) {
    .numbers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .experience li {
      grid-template-columns: 1fr;
      gap: calc(2 * var(--px));
    }
  }

  .plain {
    display: grid;
    gap: calc(6 * var(--px));
    margin-top: calc(10 * var(--px));
    font-size: var(--fs-small);
  }

</style>
