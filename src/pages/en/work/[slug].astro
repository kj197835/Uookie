---
import CasePage from '@/components/pages/CasePage.astro';
import { caseSlug, getCases } from '@/lib/cases';

export async function getStaticPaths() {
  const cases = await getCases('en');
  return cases.map((entry, i) => ({
    params: { slug: caseSlug(entry) },
    props: { entry, prev: cases[i - 1], next: cases[i + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
---

<CasePage entry={entry} prev={prev} next={next} />
